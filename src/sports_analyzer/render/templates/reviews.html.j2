<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>賽後檢討</title>
<meta name="description" content="每場已完賽比賽的賽前分析 vs 實際結果，以及模型的累計偏差">
{% include "_style.html.j2" %}
{% import "_review.html.j2" as rv %}
</head>
<body>
<div class="wrap">
<header>
  <h1>賽後檢討</h1>
  <span class="meta">更新：{{ generated_local }}（台北時間）</span>
  <a class="meta" href="index.html">回到每日分析</a>
</header>

{{ rv.howto() }}

<section>
  <h2>足球累計 <span class="count">{{ reviews.summary.matches }} 場</span></h2>
  {% if reviews.summary.matches %}
  {{ rv.football_summary(reviews.summary) }}
  {% if reviews.summary.by_comp %}
  <div class="scroll" style="margin-top:10px"><table>
    <tr><th>聯賽</th><th>場次</th><th>模型 log-loss</th><th>市場 log-loss</th><th>單場較準 模型:市場</th><th>模型偏向命中</th><th>市場預期</th></tr>
    {% for c in reviews.summary.by_comp %}
    <tr>
      <td>{{ c.name }}</td><td>{{ c.matches }}</td>
      <td class="model-val">{{ c.ll_model_ll if c.ll_model_ll is not none else '—' }}</td>
      <td class="market-val">{{ c.ll_market_ll if c.ll_market_ll is not none else '—' }}</td>
      <td>{{ c.ll_model_closer }} : {{ c.ll_market_closer }}</td>
      <td>{{ '%g'|format(c.lean_hits) }} / {{ '%g'|format(c.lean_decided) }}</td>
      <td>{{ '%g'|format(c.lean_expected) }}</td>
    </tr>
    {% endfor %}
  </table></div>
  {% endif %}
  {% if reviews.summary.n_goals %}
  <p class="sub">模型預期進球減實際進球（正 = 高估）：主隊 {{ '%+.2f'|format(reviews.summary.goal_bias_h) }}、客隊 {{ '%+.2f'|format(reviews.summary.goal_bias_a) }}（{{ reviews.summary.n_goals }} 場）{% if reviews.summary.n_xg %} · 減實際 xG：主隊 {{ '%+.2f'|format(reviews.summary.xg_bias_h) }}、客隊 {{ '%+.2f'|format(reviews.summary.xg_bias_a) }}（{{ reviews.summary.n_xg }} 場）{% endif %}</p>
  {% endif %}
  {% else %}<p class="none">還沒有已完賽的足球比賽。</p>{% endif %}
</section>

{% if reviews.mlb_summary.games %}
<section>
  <h2>MLB 累計 <span class="count">{{ reviews.mlb_summary.games }} 場</span></h2>
  <div class="kpis">
    <div class="kpi"><b>{{ reviews.mlb_summary.fav_wins }} / {{ reviews.mlb_summary.fav_n }}</b><span>熱門 ML 勝（市場預期 {{ reviews.mlb_summary.fav_expected }}）</span></div>
    <div class="kpi"><b>{{ reviews.mlb_summary.fav_covers }} / {{ reviews.mlb_summary.fav_n }}</b><span>熱門 −1.5 過盤</span></div>
    <div class="kpi"><b>{{ reviews.mlb_summary.t10_bets }} / {{ reviews.mlb_summary.t10_judged }}</b><span>T-10 價值注 / 有判斷的場次</span></div>
    {% if reviews.mlb_summary.t10_bets %}
    <div class="kpi"><b>{{ reviews.mlb_summary.t10_wins }} / {{ reviews.mlb_summary.t10_bets }}</b><span>價值注贏（平均 EV {{ '%+.1f%%'|format(reviews.mlb_summary.t10_avg_ev*100) if reviews.mlb_summary.t10_avg_ev is not none else '—' }}）</span></div>
    <div class="kpi"><b class="{{ 'pos' if reviews.mlb_summary.t10_units > 0 else ('neg' if reviews.mlb_summary.t10_units < 0 else '') }}">{{ '%+.2f'|format(reviews.mlb_summary.t10_units) }}</b><span>價值注損益（每注 1 單位）</span></div>
    {% endif %}
  </div>
</section>
{% endif %}

<section>
  <h2>每場檢討 <span class="count">新到舊</span></h2>
  <div class="grid">
    {% for r in reviews.football %}{{ rv.football_card(r) }}{% endfor %}
    {% for r in reviews.mlb %}{{ rv.mlb_card(r) }}{% endfor %}
  </div>
</section>

<footer>
  log-loss = −ln(給實際結果的機率)，越低代表賽前越看好真正發生的結果；市場是多家國際莊家去水後的中位數。比賽數據（xG、射門、紅牌）來自 football-data.co.uk，五大聯賽通常 2–3 天後補上，歐冠沒有免費來源。
</footer>
</div>
</body>
</html>

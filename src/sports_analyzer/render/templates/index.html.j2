<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>比賽分析</title>
<meta name="description" content="每日自動更新：模型勝率 vs 市場賠率">
{% include "_style.html.j2" %}
{% import "_review.html.j2" as rv %}
</head>
<body>
<div class="wrap">
<header>
  <h1>比賽分析</h1>
  <span class="meta">更新：{{ generated_local }}（台北時間）</span>
  {% if odds_budget %}<span class="meta">賠率點數剩 {{ odds_budget.remaining }}（每日預算約 {{ odds_budget.daily }}）</span>{% elif credits_remaining is not none %}<span class="meta">The Odds API 剩餘點數：{{ credits_remaining }}</span>{% endif %}
  {% if backtest %}<a class="meta" href="backtest.html">回測報告</a>{% endif %}
  <a class="meta" href="t10_backtest.html">T-10 回測</a>
  {% if reviews.total %}<a class="meta" href="reviews.html">全部賽後檢討</a>{% endif %}
</header>

<section>
  <h2>運彩價值注 <span class="count">{{ tw_values|length }} 個 · 門檻 EV ≥ {{ (cfg.value_threshold*100)|round(0)|int }}%</span></h2>
  {% if tw_reports %}
  <p class="sub">{% for r in tw_reports %}{{ r.sport }}：運彩 {{ r.tw_games }} 場，對上 {{ r.matched }} 場（{{ r.file }}）{% if r.avg_overround is not none %} · 運彩不讓分平均水錢 {{ '%.1f%%'|format(r.avg_overround*100) }}{% endif %}{% if r.unknown_teams %} · 未對照隊名 {{ r.unknown_teams|length }} 個{% endif %}{% if not loop.last %}　|　{% endif %}{% endfor %}</p>
  {% if tw_summary and (tw_summary.pending or tw_summary.settled) %}
  <div class="kpis">
    <div class="kpi"><b>{{ tw_summary.pending }}</b><span>待結算</span></div>
    <div class="kpi"><b>{{ tw_summary.settled }}</b><span>已結算</span></div>
    <div class="kpi"><b>{{ '%.0f%%'|format(tw_summary.hit_rate*100) if tw_summary.hit_rate is not none else '—' }}</b><span>命中率</span></div>
    <div class="kpi"><b class="{{ 'pos' if tw_summary.units > 0 else ('neg' if tw_summary.units < 0 else '') }}">{{ '%+.2f'|format(tw_summary.units) if tw_summary.settled else '—' }}</b><span>單位損益</span></div>
    <div class="kpi"><b class="{{ 'pos' if tw_summary.avg_clv and tw_summary.avg_clv > 0 else ('neg' if tw_summary.avg_clv and tw_summary.avg_clv < 0 else '') }}">{{ '%+.1f%%'|format(tw_summary.avg_clv*100) if tw_summary.avg_clv is not none else '—' }}</b><span>平均 CLV（{{ tw_summary.n_clv }} 注）</span></div>
  </div>
  {% endif %}
  {% if tw_values %}
  <div class="scroll"><table>
    <tr><th>開賽</th><th>聯賽</th><th>比賽（運彩名）</th><th>市場</th><th>選項</th><th>運彩賠率</th><th>公允賠率</th><th>EV</th><th>擷取</th></tr>
    {% for v in tw_values %}
    <tr>
      <td>{{ v.kickoff_local }}</td><td>{{ v.competition_name }}</td>
      <td>{{ v.away_zh }} @ {{ v.home_zh }}</td><td>{{ v.market }}{% if v.derived %} <span class="chip">推算</span>{% endif %}</td><td><b>{{ v.selection }}</b></td>
      <td class="model-val">{{ v.tw_price }}</td><td class="market-val">{{ v.fair_odds }}</td>
      <td class="pos">{{ '%+.1f%%'|format(v.ev*100) }}</td><td class="sub">{{ v.captured_at[11:16] if v.captured_at else '' }}</td>
    </tr>
    {% endfor %}
  </table></div>
  <p class="sub">EV = 市場公允機率 × 運彩賠率 − 1。只有運彩賠率高於公允賠率的注才會出現在這裡；多數日子會是空的，這是正常的。標「推算」的玩法（其他大小盤、球隊大小、兩隊都進球、單雙、讓分 1:0、上半場）沒有國際盤可直接比，公允機率是用國際盤的勝平負和大小反推兩隊預期進球後算出來的；歷史驗證誤差約 1–2%，所以門檻提高到 EV ≥ {{ (cfg.derived_value_threshold*100)|round(0)|int }}%（上半場 {{ (cfg.ht_value_threshold*100)|round(0)|int }}%）。運彩的水錢（上方「平均水錢」）遠高於國際莊家的 2–5%，所以要出現價值注，通常得是運彩開盤後市場大幅移動的場次。</p>
  {% else %}
  <p class="none">{% if tw_reports %}運彩目前沒有賠率高於公允價的注。{% else %}尚未收到運彩賠率上傳（手機捷徑設定好後會自動出現）。{% endif %}</p>
  {% endif %}
  {% else %}
  <p class="none">尚未收到運彩賠率上傳（手機捷徑設定好後會自動出現）。</p>
  {% endif %}
</section>

<section>
  <h2>{{ '訊號' if cfg.signals_validated else '模型分歧' }} <span class="count">{{ signals|length }} 個 · 門檻 edge ≥ {{ (cfg.edge_threshold*100)|round(0)|int }}pp</span></h2>
  {% if not cfg.signals_validated %}
  <div class="note" style="margin-bottom:10px">
    這些是「模型和市場看法差很多」的比賽，<b>不是下注建議</b>。
    {% if backtest_total and backtest_total.clv is not none %}
    最近回測（{{ backtest_total.generated }}）：模型對收盤線的 CLV 為 {{ '%+.1f%%'|format(backtest_total.clv*100) }}，代表模型沒有打敗市場的資訊。
    {% endif %}
    要找價值，請比較下方卡片的「公允賠率」和你實際能買到的賠率。{% if backtest %}<a href="backtest.html">看回測報告</a>{% endif %}
  </div>
  {% endif %}
  {% if ledger %}
  <div class="kpis">
    <div class="kpi"><b>{{ ledger.pending }}</b><span>待結算</span></div>
    <div class="kpi"><b>{{ ledger.settled }}</b><span>已結算</span></div>
    <div class="kpi"><b>{{ '%.0f%%'|format(ledger.hit_rate*100) if ledger.hit_rate is not none else '—' }}</b><span>命中率</span></div>
    <div class="kpi"><b class="{{ 'pos' if ledger.units and ledger.units > 0 else ('neg' if ledger.units and ledger.units < 0 else '') }}">{{ '%+.2f'|format(ledger.units) if ledger.settled else '—' }}</b><span>單位損益（每注 1）</span></div>
    <div class="kpi"><b>{{ '%+.1f%%'|format(ledger.roi*100) if ledger.roi is not none else '—' }}</b><span>ROI</span></div>
  </div>
  {% endif %}
  {% if signals %}
  <div class="scroll"><table>
    <tr><th>開賽</th><th>聯賽</th><th>比賽</th><th>市場</th><th>選項</th><th>模型</th><th>市場</th><th>Edge</th><th>最佳賠率</th><th>信心</th></tr>
    {% for s in signals %}
    <tr>
      <td>{{ s.kickoff_local }}</td><td>{{ s.competition_name }}</td>
      <td>{{ s.home }} vs {{ s.away }}</td><td>{{ s.market }}</td><td>{{ s.selection }}</td>
      <td class="model-val">{{ '%.1f%%'|format(s.model_p*100) }}</td>
      <td class="market-val">{{ '%.1f%%'|format(s.market_p*100) }}</td>
      <td class="{{ 'pos' if s.edge > 0 else 'neg' }}">{{ '%+.1f'|format(s.edge*100) }}pp</td>
      <td>{{ s.price }} <span class="sub">{{ s.book }}</span></td>
      <td>{{ s.confidence }}{% if s.caveat %} <span class="sub">({{ s.caveat }})</span>{% endif %}</td>
    </tr>
    {% endfor %}
  </table></div>
  {% else %}
  <p class="none">今天沒有超過門檻的訊號。沒訊號也是一種結果——市場定價合理時，不下注就是正確答案。</p>
  {% endif %}
</section>


<section id="review">
  <h2>賽後檢討 <span class="count">最近 {{ reviews.football|length + reviews.mlb|length }} 場 · 累計 {{ reviews.total }} 場</span></h2>
  {% if reviews.football or reviews.mlb %}
  {{ rv.howto() }}
  {% if reviews.summary.matches %}{{ rv.football_summary(reviews.summary) }}{% endif %}
  <div class="grid" style="margin-top:12px">
    {% for r in reviews.football %}{{ rv.football_card(r) }}{% endfor %}
    {% for r in reviews.mlb %}{{ rv.mlb_card(r) }}{% endfor %}
  </div>
  <p class="sub"><a href="reviews.html">看全部賽後檢討與分聯賽統計</a> · 原始資料：data/reviews/football.csv、mlb.csv（可用試算表打開）</p>
  {% else %}
  <p class="none">還沒有已完賽的比賽。比賽結束後，下一次自動更新（台北 08:15 或 20:25）會把賽前分析和實際結果放在這裡對照。</p>
  {% endif %}
  {% if waiting %}
  <p class="sub">已開賽、等待賽果：{% for c in waiting %}{{ c.home }} vs {{ c.away }}{% if not loop.last %}、{% endif %}{% endfor %}</p>
  {% endif %}
</section>

{% for comp in competitions %}
<section>
  <h2>{{ comp.name }} <span class="count">{{ comp.cards|length }} 場{% if comp.model %} · 模型樣本 {{ comp.model.n_matches }} 場 · 主場優勢 {{ comp.model.home_advantage }}{% endif %}</span></h2>
  {% if comp.cards %}
  <div class="grid">
  {% for c in comp.cards %}
    <article class="card">
      <div class="top"><span>{{ c.kickoff_local }}{% if c.matchday %} · 第 {{ c.matchday }} 輪{% endif %}</span><span>{{ c.competition_name }}</span></div>
      <div class="teams">
        <div><div class="name">{{ c.home }}</div><div class="sub">{% if c.table.home %}第 {{ c.table.home.position }} 名 · {{ c.table.home.points }} 分{% endif %}{% if c.form.home %} · {{ c.form.home|replace(',', '') }}{% endif %}</div></div>
        <div class="vs">vs</div>
        <div class="away"><div class="name">{{ c.away }}</div><div class="sub">{% if c.table.away %}第 {{ c.table.away.position }} 名 · {{ c.table.away.points }} 分{% endif %}{% if c.form.away %} · {{ c.form.away|replace(',', '') }}{% endif %}</div></div>
      </div>

      {% if c.model.fitted %}
      <div class="bars">
        {% for key, lab in (('p_home','主勝'),('p_draw','和局'),('p_away','客勝')) %}
        {% set mkt = c.market.h2h[key[2:]].fair if c.market and c.market.h2h else none %}
        <span class="lab">{{ lab }}</span>
        <div class="bar"><i class="k" style="width: {{ (mkt*100)|round(1) if mkt is not none else 0 }}%"></i><i class="m" style="width: {{ (c.model[key]*100)|round(1) }}%; opacity:.85"></i></div>
        <span class="model-val">{{ '%.0f%%'|format(c.model[key]*100) }}</span>
        <span class="market-val">{{ '%.0f%%'|format(mkt*100) if mkt is not none else '—' }}</span>
        {% endfor %}
      </div>
      <div class="legend"><span><i style="background:var(--model)"></i>模型</span><span><i style="background:var(--market);opacity:.55"></i>市場（去水）</span></div>
      <div class="facts">
        {% if c.market and c.market.h2h %}<div style="grid-column: 1 / -1"><span>公允賠率（市場）</span><span>主 <b>{{ c.market.h2h.home.fair_odds }}</b> · 和 <b>{{ c.market.h2h.draw.fair_odds }}</b> · 客 <b>{{ c.market.h2h.away.fair_odds }}</b>{% if c.market.totals %} · 大{{ c.market.totals.line }} <b>{{ c.market.totals.over.fair_odds }}</b> / 小 <b>{{ c.market.totals.under.fair_odds }}</b>{% endif %}</span></div>{% endif %}
        {% if c.tw and c.tw.h2h %}<div style="grid-column: 1 / -1"><span>運彩賠率 <span class="sub">{{ c.tw.captured_at[11:16] if c.tw.captured_at else '' }}</span></span><span>{% for side, lab in (('home','主'),('draw','和'),('away','客')) %}{% if c.tw.h2h[side] %}{{ lab }} <b class="{{ 'pos' if c.tw.h2h[side].ev >= cfg.value_threshold else '' }}">{{ c.tw.h2h[side].price }}</b><span class="sub">({{ '%+.0f%%'|format(c.tw.h2h[side].ev*100) }})</span>{% if not loop.last %} · {% endif %}{% endif %}{% endfor %}{% if c.tw.totals %} · 大{{ c.tw.totals.line }} <b class="{{ 'pos' if c.tw.totals.over and c.tw.totals.over.ev >= cfg.value_threshold else '' }}">{{ c.tw.totals.over.price if c.tw.totals.over else '—' }}</b> / 小 <b class="{{ 'pos' if c.tw.totals.under and c.tw.totals.under.ev >= cfg.value_threshold else '' }}">{{ c.tw.totals.under.price if c.tw.totals.under else '—' }}</b>{% endif %}</span></div>{% endif %}
        {% if c.tw and c.tw.derived %}<div style="grid-column: 1 / -1"><span>其他玩法最接近公允價 <span class="chip">推算</span></span><span>{% for d in c.tw.derived[:2] %}{{ d.selection }} <b class="{{ 'pos' if d.ev >= cfg.derived_value_threshold else '' }}">{{ d.tw_price }}</b><span class="sub">（公允 {{ d.fair_odds }}，{{ '%+.0f%%'|format(d.ev*100) }}）</span>{% if not loop.last %} · {% endif %}{% endfor %}</span></div>{% endif %}
        <div><span>預期進球</span><span>{{ c.model.lambda_home }} – {{ c.model.mu_away }}</span></div>
        <div><span>最可能比分</span><span>{{ c.model.most_likely }}</span></div>
        <div><span>大 2.5 球</span><span class="model-val">{{ '%.0f%%'|format(c.model.over25*100) }}{% if c.market and c.market.totals and c.market.totals.line == 2.5 %} <span class="market-val">/ {{ '%.0f%%'|format(c.market.totals.over.fair*100) }}</span>{% endif %}</span></div>
        <div><span>攻／守排名</span><span>{{ c.model.home_attack_rank }}/{{ c.model.home_defence_rank }} vs {{ c.model.away_attack_rank }}/{{ c.model.away_defence_rank }} <span class="sub">(共{{ c.model.n_teams }})</span></span></div>
        {% if c.market and c.market.spread %}<div><span>讓球 {{ '%+g'|format(c.market.spread.line) }}</span><span class="market-val">{{ '%.0f%%'|format(c.market.spread.home.fair*100) }} / {{ '%.0f%%'|format(c.market.spread.away.fair*100) }}</span></div>{% endif %}
        {% if c.h2h %}<div><span>近期交手</span><span>{% for h in c.h2h[:2] %}{{ h.score }}{% if not loop.last %}, {% endif %}{% endfor %}</span></div>{% endif %}
      </div>
      {% else %}
      <p class="none">尚無模型預測。</p>
      {% endif %}

      <div class="rec">
        {% if c.recommendation %}
          <span class="sub">{{ '推薦' if cfg.signals_validated else '模型偏向' }}</span>
          <b>{{ c.recommendation.selection }}</b> @ {{ c.recommendation.price }} <span class="sub">{{ c.recommendation.book }}</span>
          <span class="chip {{ 'high' if c.recommendation.confidence == '高' else ('mid' if c.recommendation.confidence == '中' else '') }}">{{ '信心' if cfg.signals_validated else '分歧' }} {{ c.recommendation.confidence }}</span>
          <div class="sub">模型 {{ '%.1f%%'|format(c.recommendation.model_p*100) }} vs 市場 {{ '%.1f%%'|format(c.recommendation.market_p*100) }} · edge {{ '%+.1f'|format(c.recommendation.edge*100) }}pp · 1/4 Kelly {{ '%.1f%%'|format(c.recommendation.kelly*100) }}</div>
        {% else %}
          <span class="none">模型與市場看法接近</span>
        {% endif %}
      </div>
      {% for n in c.notes %}<div class="note">{{ n }}</div>{% endfor %}
    </article>
  {% endfor %}
  </div>
  {% else %}
  <p class="none">視窗內沒有比賽。</p>
  {% endif %}
</section>
{% endfor %}

{% if mlb %}
<section>
  <h2>MLB <span class="count">{{ mlb.games|length }} 場 · 市場公允賠率與 T-10 G 值（模型 Phase 3 建置中）</span></h2>
  {% if mlb.games %}
  <div class="grid">
  {% for g in mlb.games %}
    <article class="card">
      <div class="top"><span>{{ g.local }}</span><span>{{ g.status }}</span></div>
      <div class="teams">
        <div><div class="name">{{ g.away }}</div><div class="sub">{{ g.away_probable or '先發未定' }}</div></div>
        <div class="vs">@</div>
        <div class="away"><div class="name">{{ g.home }}</div><div class="sub">{{ g.home_probable or '先發未定' }}</div></div>
      </div>
      {% if g.market and g.market.h2h %}
      <div class="facts">
        <div style="grid-column: 1 / -1"><span>公允賠率（市場）</span><span>客 <b>{{ g.market.h2h.away.fair_odds }}</b> · 主 <b>{{ g.market.h2h.home.fair_odds }}</b>{% if g.market.spread %} · 讓分 {{ '%+g'|format(g.market.spread.line) }} 主 <b>{{ g.market.spread.home.fair_odds }}</b> / 客 <b>{{ g.market.spread.away.fair_odds }}</b>{% endif %}{% if g.market.totals %} · 大小 {{ g.market.totals.line }} <b>{{ g.market.totals.over.fair_odds }}</b> / <b>{{ g.market.totals.under.fair_odds }}</b>{% endif %}</span></div>
        {% if g.tw and g.tw.h2h %}<div style="grid-column: 1 / -1"><span>運彩賠率 <span class="sub">{{ g.tw.captured_at[11:16] if g.tw.captured_at else '' }}</span></span><span>{% if g.tw.h2h.away %}客 <b class="{{ 'pos' if g.tw.h2h.away.ev >= cfg.value_threshold else '' }}">{{ g.tw.h2h.away.price }}</b><span class="sub">({{ '%+.0f%%'|format(g.tw.h2h.away.ev*100) }})</span>{% endif %}{% if g.tw.h2h.home %} · 主 <b class="{{ 'pos' if g.tw.h2h.home.ev >= cfg.value_threshold else '' }}">{{ g.tw.h2h.home.price }}</b><span class="sub">({{ '%+.0f%%'|format(g.tw.h2h.home.ev*100) }})</span>{% endif %}{% if g.tw.spread and g.tw.spread.home %} · 讓分 主 <b class="{{ 'pos' if g.tw.spread.home.ev >= cfg.value_threshold else '' }}">{{ g.tw.spread.home.price }}</b> / 客 <b class="{{ 'pos' if g.tw.spread.away and g.tw.spread.away.ev >= cfg.value_threshold else '' }}">{{ g.tw.spread.away.price if g.tw.spread.away else '—' }}</b>{% endif %}{% if g.tw.totals and g.tw.totals.over %} · 大小 <b class="{{ 'pos' if g.tw.totals.over.ev >= cfg.value_threshold else '' }}">{{ g.tw.totals.over.price }}</b> / <b class="{{ 'pos' if g.tw.totals.under and g.tw.totals.under.ev >= cfg.value_threshold else '' }}">{{ g.tw.totals.under.price if g.tw.totals.under else '—' }}</b>{% endif %}</span></div>{% endif %}
        <div><span>市場勝率</span><span class="market-val">客 {{ '%.0f%%'|format(g.market.h2h.away.fair*100) }} · 主 {{ '%.0f%%'|format(g.market.h2h.home.fair*100) }}</span></div>
        <div><span>最佳賠率</span><span>{{ g.market.h2h.away.best }} / {{ g.market.h2h.home.best }} <span class="sub">({{ g.market.books }} 家)</span></span></div>
        {% if g.t10 %}
        <div style="grid-column: 1 / -1"><span>T-10 G 值（{{ '主' if g.t10.favourite == 'home' else '客' }}隊熱門）</span><span class="{{ 'model-val' if g.t10.signal else '' }}">{{ '%+.1f'|format(g.t10.g*100) }}pp{% if g.t10.signal == 'FAV_ML' %} → 熱門 ML{% elif g.t10.signal == 'DOG_PLUS_1_5' %} → 冷門 +1.5{% else %} → 無訊號（門檻 ±{{ (g.t10.threshold*100)|int }}pp）{% endif %}</span></div>
        {% endif %}
        {% if g.venue %}<div><span>球場</span><span>{{ g.venue }}</span></div>{% endif %}
      </div>
      {% else %}
      <p class="none">尚無賠率。</p>
      {% endif %}
      {% for n in g.notes %}<div class="note">{{ n }}</div>{% endfor %}
    </article>
  {% endfor %}
  </div>
  <p class="sub">G 值用的是早上快照的賠率，不是 T-10 要求的開賽前 10 分鐘尾盤；尾盤請自行查詢後套用同一公式。</p>
  {% else %}<p class="none">今天沒有 MLB 比賽。</p>{% endif %}
</section>
{% endif %}

<footer>
  模型：Dixon-Coles（足球）。市場機率為多家國際莊家去水後的中位數，非台灣運彩盤口。「公允賠率」= 1 ÷ 市場去水機率：你實際能買到的賠率高於它才有價值，低於它就是在付水錢。數字是機率估計，不是保證；請自行判斷並控制風險。
</footer>
</div>
</body>
</html>

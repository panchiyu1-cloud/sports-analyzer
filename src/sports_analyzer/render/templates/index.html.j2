{% extends "base.html.j2" %}
{% import "_ui.html.j2" as ui %}
{% block description %}每日自動更新：運彩賠率 vs 國際公允價，每種分析方法的賽前分析與賽後檢討{% endblock %}
{% block main %}
<section class="hero hub">
  <p class="kicker">{{ updated[:5] }} 更新・接下來 48 小時 {{ counts.matches }} 場</p>
  <h1 class="{{ headline_tone }}">{{ headline }}</h1>
  {% if next_upload %}
  <p class="lede"><b>建議下次上傳 {{ next_upload.at_local[6:] }}</b>{% if next_upload.at_local[:5] != updated[:5] %}（{{ next_upload.at_local[:5] }}）{% endif %}：{{ next_upload.sport_label }} {{ next_upload.first_local }}{% if next_upload.last_local != next_upload.first_local %}–{{ next_upload.last_local }}{% endif %} 開賽的 {{ next_upload.games }} 場。開賽前 1 小時上傳，系統會先買最新國際價再比。{% if next_upload.now %} <span class="chip warn">現在上傳</span>{% endif %}</p>
  {% else %}
  <p class="lede">運彩水錢高，可下的注通常要等國際盤大幅移動、運彩還沒跟上的時候；多數時候沒有，這是正常的。</p>
  {% endif %}
  <dl class="bug">
    <div><dt>可下</dt><dd class="{{ 'good' if counts.value else '' }}">{{ counts.value }}</dd></div>
    <div><dt>雷達候選</dt><dd class="{{ 'good' if counts.radar else '' }}">{{ counts.radar }}</dd></div>
    <div><dt>國際大單</dt><dd class="{{ 'warn' if counts.big else '' }}">{{ counts.big }}</dd></div>
    <div><dt>賠率點數</dt><dd>{{ budget.remaining if budget else '—' }}{% if budget %}<small> 剩</small>{% endif %}</dd></div>
  </dl>
</section>

<h2 class="sect">分析方法 <span class="count">點進去：上面是還沒開賽的分析卡，「歷史數據」是打完的比賽檢討</span></h2>
<div class="tiles">
  {% for t in tiles %}
  <a class="tile" href="{{ t.page }}.html">
    <b>{{ t.name }}</b>
    <span class="now">{{ t.now }}</span>
    <span class="what">{{ t.what }}</span>
    <span class="tsub">{{ t.sub }}</span>
  </a>
  {% endfor %}
</div>

<h2 class="sect">賽程 <span class="count">台灣時間。今天已開賽的也留著；標籤是哪個方法對這場有話說，點標籤直接看那張卡</span></h2>
{% if board %}
{% for d in board %}
<div class="day-h">{{ d.day }}</div>
<ul class="fixtures">
  {% for m in d.matches %}
  <li class="fx{% if m.flags %} flagged{% endif %}{% if m.started %} started{% endif %}">
    <span class="fx-time">{{ m.when.time }}</span>
    <span class="fx-comp">{{ m.competition }}{% if not m.on_tw and not m.started %}・運彩未開盤{% endif %}</span>
    <span class="fx-teams">{{ m.title }}</span>
    <span class="fx-flags">{% if m.started %}{% if m.score %}<a class="chip final" href="{{ m.href }}">{{ m.score }}・看檢討</a>{% else %}<span class="chip ghost">已開賽・等賽果</span>{% endif %}{% endif %}{% for f in m.flags %}<a class="chip {{ f.tone }}" href="{{ f.href }}">{{ f.label }}</a>{% endfor %}</span>
  </li>
  {% endfor %}
</ul>
{% endfor %}
{% else %}
{{ ui.empty("今天起 48 小時內沒有比賽", "每天 08:15、20:25（台灣時間）會抓新的賽程和國際賠率。") }}
{% endif %}

{% if last %}
<p class="stamp-line">最後一次看到　{% for s in last %}{{ s.sport }}：運彩 {{ s.tw|tpe }}・國際 {{ s.intl|tpe }}{% if not loop.last %}　｜　{% endif %}{% endfor %}{% if budget %}　｜　賠率點數剩 {{ budget.remaining }}，每日預算約 {{ budget.daily }}{% endif %}</p>
{% endif %}
<p class="links"><a href="reviews.html">全部賽後檢討（{{ reviews_n }} 場）</a><a href="t10_backtest.html">T-10 回測</a><a href="backtest.html">足球模型回測</a><a href="fade.html#backtest">反者道之動回測</a></p>
{% endblock %}

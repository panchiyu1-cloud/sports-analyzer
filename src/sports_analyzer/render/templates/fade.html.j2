{% extends "base.html.j2" %}
{% import "_ui.html.j2" as ui %}
{% block description %}反者道之動：最差的押法是哪些，反著做在國際價和運彩價各會怎樣；今日反指標與真實運彩價的反向紀錄{% endblock %}
{% block main %}
{% macro strategy_table(rows) %}
<div class="scroll"><table class="tbl">
  <thead><tr><th>押法</th><th class="r">差距（z）</th><th class="r">反著做：運彩價</th><th class="r">國際價</th><th class="r">理論</th><th class="r">命中 vs 市場</th><th class="r">前段／後段</th><th class="r">場數</th></tr></thead>
  <tbody>
  {% for r in rows %}
  <tr>
    <td class="wrap-cell">{{ r.name }}<span class="sub">{{ r.sport }}{% if r.span %}・{{ r.span }}{% endif %}</span></td>
    <td class="num {{ 'neg' if r.self.gap_pp < 0 else 'pos' }}">{{ '%+.2f'|format(r.self.gap_pp) }}<span class="sub">z {{ '%+.1f'|format(r.self.z) if r.self.z is not none else '—' }}</span></td>
    <td class="num {{ 'pos' if r.fade.roi_tw > 0 else 'neg' }}">{{ '%+.1f%%'|format(r.fade.roi_tw) }}</td>
    <td class="num {{ 'pos' if r.fade.roi_intl > 0 else 'neg' }}">{{ '%+.1f%%'|format(r.fade.roi_intl) }}<span class="sub">最佳 {{ '%+.1f'|format(r.fade.roi_best) }}</span></td>
    <td class="num {{ 'pos' if r.fade.roi_fair > 0 else 'neg' }}">{{ '%+.1f%%'|format(r.fade.roi_fair) }}</td>
    <td class="num">{{ r.self.hit }}% / {{ r.self.fair }}%</td>
    <td class="num">{% if r.early and r.early.n %}{{ '%+.1f'|format(r.early.gap_pp) }} / {{ '%+.1f'|format(r.late.gap_pp) }}{% else %}—{% endif %}</td>
    <td class="num">{{ '{:,}'.format(r.self.n) }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table></div>
{% endmacro %}
{{ ui.hero("反者道之動",
  "你的想法：找出最常失敗的押法，反過來做。這裡的「差」不是輸得多（冷門本來就常輸），而是押中的比例比市場自己算的機率還低。下面是回測找出來最差的幾種、反著做在運彩值不值得，以及每天符合條件的比賽。",
  [
    {"label": "測試的押法", "value": s.tested if s else "—"},
    {"label": "兩段時間都差", "value": s.consistent|length if s else "—"},
    {"label": "反著做在運彩賺錢", "value": s.profitable_tw if s else "—", "tone": ("good" if s.profitable_tw else "bad") if s else ""},
    {"label": "今日反指標", "value": live|length},
  ]) }}
<blockquote class="quote">反者道之動，弱者道之用。<span>《道德經》第四十章</span></blockquote>
{{ ui.tabs([("upcoming", "今日反指標", live|length), ("history", "反向紀錄", record_n), ("backtest", "回測", none)]) }}

<section id="upcoming" class="tabpanel active" role="tabpanel">
  <p class="howto">還沒開賽的比賽裡，最差的幾種押法會押哪一邊；這裡列的是<b>反過來那一邊</b>在運彩的價格。EV = 公允機率 × 運彩賠率 − 1；要到門檻（足球 {{ (cfg.value_threshold * 100)|round|int }}%、MLB {{ (cfg.mlb_value_threshold * 100)|round|int }}%）才值得下，那時它也會出現在運彩價值頁。多數會是負的：反指標也要看價格。卡片下的線圖是這一邊每次抓價時的機率：藍線是國際公允機率，橘線是運彩賠率換算成的機率（含水錢）；藍線高過橘線，EV 才是正的。足球反押一個結果要同時押另外兩個（按比例分注），合起來的賠率可能低於 1，那就是怎麼樣都賠。</p>
  {% if live %}
  <div class="cards">
  {% for r in live %}
    <article class="match"{% if r.id %} id="{{ r.id }}"{% endif %} data-status="{{ r.status }}">
      <div class="mt"><span class="comp">{{ r.sport }}</span><span class="kick">{{ r.when.date }} {{ r.when.time }}</span><span>{{ r.when.weekday }}</span><span class="eta">{{ r.when.eta }}</span></div>
      <h3 class="teams">{{ r.match }}</h3>
      <div class="verdict">{{ ui.status_chip(r.status) }}<span>反著押 <b>{{ r.fade_label }}</b>{% if r.tw_price %} @ {{ '%.2f'|format(r.tw_price) }}{% endif %}</span>{% if r.ev is not none %}<span class="{{ 'pos' if r.ev >= r.threshold else ('neg' if r.ev < 0 else '') }}">EV {{ '%+.1f%%'|format(r.ev * 100) }}</span>{% endif %}</div>
      {% if r.tw_price and r.tw_price < 1 %}<p class="sub neg">合起來的賠率低於 1：不管結果都賠</p>{% endif %}
      <dl class="facts">
        <dt>反指標</dt><dd>{{ r.names|join('、') }}</dd>
        <dt>這一邊</dt><dd>公允機率 {{ '%.0f%%'|format(r.fair_prob * 100) }}</dd>
      </dl>
      {{ ui.timeline(r, "這一邊的機率：藍線高過橘線才有 EV") }}
    </article>
  {% endfor %}
  </div>
  {% else %}
  <p class="none">目前沒有符合的比賽。</p>
  {% endif %}
</section>

<section id="history" class="tabpanel" role="tabpanel">
  <h2>反向紀錄 <span class="count">真實運彩價・{{ record_n }} 注</span></h2>
  <p class="howto">從開始記錄起，每場打完的比賽裡，上面幾種押法賽前會押的那一邊，反過來押的結果。運彩價是開賽前最後一次上傳的價格（足球反押一個結果＝另外兩個結果按比例分注）；沒有運彩價的只算命中，不算損益。<b>做對了</b>：反著押贏得比市場預期多，而且用運彩價還有賺；<b>做錯了</b>：贏得比預期少，或贏了也被水錢吃掉。</p>
  {% if record_summary %}
  <div class="scroll"><table class="tbl">
    <thead><tr><th>反指標</th><th class="r">運彩損益</th><th class="r">報酬率</th><th class="r">反著押贏 / 市場預期</th><th class="r">注數</th></tr></thead>
    <tbody>
    {% for t in record_summary %}
    <tr>
      <td class="wrap-cell">{{ t.name }}<span class="sub">{{ t.sport }}・反著{{ t.fade }}</span></td>
      <td class="num {{ 'pos' if t.units > 0 else ('neg' if t.units < 0 else '') }}">{{ '%+.2f'|format(t.units) if t.priced else '—' }}<span class="sub">{{ t.priced }} 注有運彩價</span></td>
      <td class="num">{{ '%+.1f%%'|format(t.roi) if t.roi is not none else '—' }}</td>
      <td class="num">{{ '%g'|format(t.wins) }} / {{ t.expected }}</td>
      <td class="num">{{ t.n }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% endif %}
  {% if record %}
  <h2 class="sect">每一注 <span class="count">最近 {{ record|length }} 注</span></h2>
  <div class="scroll"><table class="tbl">
    <thead><tr><th>開賽</th><th>比賽</th><th>反著押</th><th class="r">結果</th><th class="r">損益</th></tr></thead>
    <tbody>
    {% for r in record %}
    <tr>
      <td class="num">{{ r.kickoff_utc|tpe }}</td>
      <td class="wrap-cell">{{ r.match }}<span class="sub">{{ r.sport }}・{{ r.strategy_name }}{% if r.score %}・{{ r.score }}{% endif %}</span></td>
      <td class="wrap-cell"><b>{{ r.fade_label }}</b>{% if r.tw_price %} @ {{ '%.2f'|format(r.tw_price) }}{% endif %}</td>
      <td class="num {{ 'good' if r.result in ('win', 'half_win') else ('bad' if r.result in ('loss', 'half_loss') else '') }}">{{ r.result_label }}</td>
      <td class="num">{% if r.units is not none %}<span class="{{ 'pos' if r.units >= 0.005 else ('neg' if r.units <= -0.005 else '') }}">{{ '%+.2f'|format(r.units) if r.units|abs >= 0.005 else '0.00' }}</span>{% else %}<span class="muted">沒有運彩價</span>{% endif %}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% else %}
  {{ ui.empty("還沒有反向紀錄", "符合反指標的比賽打完後，反著押的結果會記在這裡。") }}
  {% endif %}
</section>

<section id="backtest" class="tabpanel" role="tabpanel">
{% if s %}
  <h2>結論</h2>
  <p class="lead">
    測了 <b>{{ s.tested }}</b> 種押法（MLB {{ '{:,}'.format(s.data.mlb_games) }} 場、足球 {{ s.data.football_leagues }} 個聯賽 {{ '{:,}'.format(s.data.football_matches) }} 場）。
    兩段時間都比市場差的有 <b>{{ s.consistent|length }}</b> 種，最差的是「{{ s.worst.name }}」：實際命中 {{ s.worst.self.hit }}%，市場自己算的是 {{ s.worst.self.fair }}%。
    反著做，不算水錢時多半是正的；但用運彩的價格<b>沒有一種賺錢</b>，最好的「{{ s.best_tw.name }}」反著做也是 {{ '%+.1f'|format(s.best_tw.roi) }}%。
    原因是水錢：最差的押法也只比市場差 1–3 個百分點，運彩的水錢 MLB 約 {{ (s.margins.mlb * 100)|round|int }}%、足球不讓分約 {{ (s.margins['1x2'] * 100)|round|int }}%，而且冷門抽得最重（約 40%）。
    真正能「反」的是<b>運彩自己的價格</b>：運彩的投注者把某一邊壓得太低時，另一邊就比國際公允價便宜，那就是<a href="value.html">運彩價值</a>。
  </p>

  <h2 class="sect">差多少 vs 要差多少才夠反 <span class="count">百分點（pp）</span></h2>
  <p class="howto">白條是反著做實際比市場多贏多少；藍線是用國際莊家價打平要多贏的，橘線是用運彩價打平要多贏的。白條要越過橘線，反著押運彩才會賺。</p>
  <div class="gapchart" role="img" aria-label="各押法反著做的實際優勢與打平門檻">
    <div class="legend-row"><span><i class="l-have"></i>反著做實際多贏</span><span><i class="l-intl"></i>國際價打平線</span><span><i class="l-tw"></i>運彩價打平線</span></div>
    {% for c in s.chart %}
    <div class="gap-row">
      <div class="lab">{{ c.name }}<span class="sub">{{ c.sport }}</span></div>
      <div class="track" title="{{ c.name }}：反著做多贏 {{ '%+.1f'|format(c.have) }}pp；國際價要 {{ c.need_intl }}pp、運彩價要 {{ c.need_tw }}pp 才打平">
        <span class="have" style="width: {{ c.w_have }}%"></span>
        <span class="need" style="left: {{ c.x_intl }}%"></span>
        <span class="need tw{{ ' off' if c.need_tw and c.need_tw > s.chart_max else '' }}" style="left: {{ c.x_tw }}%"></span>
      </div>
      <div class="val"><b>{{ '%+.1f'|format(c.have) }}</b> ／ 需 {{ c.need_intl }}・{{ c.need_tw }}{% if c.impossible %} <span class="neg">不可能</span>{% endif %}</div>
    </div>
    {% endfor %}
    <div class="axis"><span></span><span class="ticks"><span>0</span><span>5</span><span>10</span><span>{{ s.chart_max|int }}pp</span></span><span></span></div>
  </div>
  <p class="sub">「不可能」：反向那一邊的公允機率加上運彩要的差距超過 100%，就算每場都贏也賠錢（例如反押大冷門＝押另外兩個結果，公允機率約 93%）。</p>

  <h2 class="sect">穩定比市場差的押法 <span class="count">{{ s.consistent|length }} 種・兩段時間都差</span></h2>
  <p class="howto">「命中 vs 市場」：實際命中率對市場收盤去水後的機率（市場自己算的）。差距為負、z 小於 −1.8，而且前段（MLB {{ s.data.halves.mlb[0] }}、足球 {{ s.data.halves.football[0] }}）和後段（{{ s.data.halves.mlb[1] }}、{{ s.data.halves.football[1] }}）都為負，才列在這裡。「反著做」三欄是反過來押的報酬率：運彩價、國際價（MLB 美國莊家收盤價、足球各家平均收盤價；小字是各家最好的價）、理論（不算水錢）。</p>
  {{ strategy_table(s.consistent) }}

  <h2 class="sect">你和系統自己的方法 <span class="count">{{ s.mine|length }} 種</span></h2>
  <p class="howto">T-10 原始規則、模型分歧、追大單。模型分歧只有 2024–2026 的五大聯賽資料，分不出前後段。</p>
  {{ strategy_table(s.mine) }}

  <details class="more">
    <summary>其他 {{ s.rest|length }} 種押法（全部結果，最差的在前）</summary>
    {{ strategy_table(s.rest) }}
  </details>
  <p class="stamp-line">回測（{{ s.generated|stamp }}）：MLB {{ s.data.mlb_seasons }} 共 {{ '{:,}'.format(s.data.mlb_games) }} 場（六家美國莊家，排除混入的盤中價），足球 {{ s.data.football_seasons }} {{ s.data.football_leagues }} 個聯賽 {{ '{:,}'.format(s.data.football_matches) }} 場（football-data.co.uk）。市場機率是收盤價去水後的機率（足球用 Pinnacle）。運彩價依它實際的水錢換算：足球的水錢多抽在冷門上（熱門約 13%、最冷的一邊約 40%），對 191 個真實盤口的誤差約 4%；MLB 兩邊差不多，平均分配。一次測幾十種押法，就算全部沒有規律，也會有一兩種看起來 z 小於 −2，所以只看兩段時間都差的。</p>
{% else %}
  {{ ui.empty("回測結果還沒產生", "執行 scripts/backtest_fade.py 之後會出現在這裡（data/fade_summary.json）。") }}
{% endif %}
</section>
{% endblock %}

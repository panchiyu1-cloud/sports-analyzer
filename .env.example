# Copy this file to `.env` for local runs. On GitHub the same two values live in
# Settings → Secrets and variables → Actions, NOT in this file.
#
# football-data.org — sent as the X-Auth-Token header
FOOTBALL_DATA_TOKEN=paste-your-token-here

# the-odds-api.com — sent as the apiKey query parameter
ODDS_API_KEY=paste-your-key-here

# Optional overrides (defaults are fine)
# ODDS_REGIONS=eu
# FIXTURE_WINDOW_DAYS=2
# EDGE_THRESHOLD=0.04
